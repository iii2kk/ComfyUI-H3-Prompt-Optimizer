# OpenAI-compatible local VLM server. /v1/chat/completions is appended automatically.
H3_OPTIMIZER_BASE_URL=http://localhost:1234

# Optional. Omit this when the server chooses its loaded model.
# H3_OPTIMIZER_MODEL=Qwen3-VL-8B-Instruct

# Optional bearer token.
# H3_OPTIMIZER_API_KEY=

H3_OPTIMIZER_TIMEOUT_SECONDS=300
