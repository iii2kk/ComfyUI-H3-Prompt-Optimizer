# Copy this file to .env. Process environment variables take precedence over .env.
# MINIMAX_* keys are shared with ComfyUI-MiniMaxH3-Prompt-Generator.
# If a key is absent here, the Optimizer reads it from that plugin's .env.

# OpenAI-compatible local VLM server. This remains the default backend.
# /v1/chat/completions is appended automatically.
MINIMAX_BASE_URL=http://localhost:1234

# Optimizer-only OpenAI-compatible request settings.
# Omit MODEL when the server chooses its loaded model.
# H3_OPTIMIZER_MODEL=Qwen3-VL-8B-Instruct

# Optional bearer token.
# H3_OPTIMIZER_API_KEY=

H3_OPTIMIZER_TIMEOUT_SECONDS=300

# Local one-shot llama-cli backend. Uncomment and set these values to enable it.
# Each LLM request starts llama-cli, loads the model, runs one inference, and exits.
# MINIMAX_VLM_BACKEND=llama_cli
# MINIMAX_LLAMA_CLI_PATH=/absolute/path/to/llama-cli
# MINIMAX_LLAMA_MODEL_PATH=/absolute/path/to/vlm-model.gguf
# MINIMAX_LLAMA_MMPROJ_PATH=/absolute/path/to/mmproj-model.gguf

# Optional llama-cli resource settings.
# MINIMAX_LLAMA_DEVICE=CUDA0
# MINIMAX_LLAMA_GPU_LAYERS=auto
# MINIMAX_LLAMA_CTX_SIZE=65536
# MINIMAX_LLAMA_FIT_TARGET_MIB=1024
# MINIMAX_LLAMA_IMAGE_MAX_TOKENS=1024

# Existing H3_OPTIMIZER_* aliases for shared MINIMAX_* keys remain supported as
# Optimizer-only overrides. For example: H3_OPTIMIZER_VLM_BACKEND.
